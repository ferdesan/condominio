# Template de variaveis de ambiente.
#
# Nao preencha os secrets a mao nem copie este arquivo com `cp`: rode
#
#     npm run secrets
#
# que gera o .env com JWT_SECRET, JWT_REFRESH_SECRET, DB_PASSWORD e
# DB_ROOT_PASSWORD aleatorios. As quatro chaves ficam vazias aqui de proposito
# — um valor que funcione neste arquivo e um valor que vaza no repositorio.

# Este arquivo e o do docker compose. Ha outros dois, e os tres usam os mesmos
# nomes para as mesmas coisas:
#   .env            sobe a stack em container (docker compose up)
#   backend/.env    roda a API fora do container (npm run dev), e le mais
#                   variaveis do que estas — veja backend/.env.example
#   frontend/.env   variaveis VITE_, lidas pelo Vite no build

# === Environment ===
NODE_ENV=development

# === Server Configuration ===
API_PORT=3333
API_URL=http://localhost:3333
WEB_PORT=3000

# === Database Configuration ===
DB_HOST=localhost
DB_PORT=3306
DB_USER=admin
DB_NAME=condominio_db
# Gerados por `npm run secrets`:
DB_PASSWORD=
DB_ROOT_PASSWORD=

# === Redis Configuration ===
REDIS_HOST=localhost
REDIS_PORT=6379

# === JWT Configuration ===
# Gerados por `npm run secrets`:
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# === Frontend Configuration ===
# Caminho relativo: tanto o Vite (dev) quanto o nginx (container) repassam /api
# para a API. URL absoluta aqui reintroduz CORS e perde o prefixo /api/v1.
VITE_API_URL=/api/v1

# === AWS S3 Configuration (Optional) ===
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# === Email Configuration (Optional) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# === Logging ===
LOG_LEVEL=info
LOG_FORMAT=json
