# ===========================================================================
# Aplicacao
# ===========================================================================
NODE_ENV=development
PORT=3333
API_PREFIX=/api/v1
APP_NAME=Condominio SaaS
API_URL=http://localhost:3333

# ===========================================================================
# Banco de dados (MySQL 8+)
# ===========================================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=condominio
# A senha do MySQL que ja esta na sua maquina — o `npm run secrets:backend` nao
# mexe nela, porque quem manda aqui e a instancia, nao este arquivo.
DB_PASSWORD=condominio
DB_NAME=condominio
DB_LOGGING=false
# Nunca habilite em producao: use migrations.
DB_SYNCHRONIZE=false
DB_POOL_SIZE=10

# ===========================================================================
# Redis (cache, rate limit distribuido). REDIS_ENABLED=false usa memoria local.
# ===========================================================================
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL_SECONDS=60

# ===========================================================================
# Autenticacao
#
# Os dois segredos ficam vazios aqui de proposito: um valor que funcione neste
# arquivo e um valor versionado, e quem tem o repositorio passa a saber com que
# chave os tokens sao assinados. Preencha com
#
#     npm run secrets:backend
#
# que sorteia os dois e preserva o resto deste arquivo.
# ===========================================================================
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
PASSWORD_RESET_TTL_MINUTES=30

# ===========================================================================
# E-mail (link de recuperacao de senha)
#
# Sem SMTP_HOST a API nao quebra: em desenvolvimento a mensagem sai no console
# com o link utilizavel, e em producao apenas o erro e registrado — ninguem
# recebe o e-mail. Para enviar de verdade, preencha os cinco.
# ===========================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# Base publica do front, de onde sai o link de redefinicao de senha. Nao e a
# API_URL: quem abre o link e o navegador do usuario. Em producao precisa ser
# a URL real — o boot recusa localhost.
FRONTEND_URL=http://localhost:5173

# ===========================================================================
# Seguranca
# ===========================================================================
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
# Habilite quando a API estiver atras de proxy/load balancer.
TRUST_PROXY=false

# ===========================================================================
# Uploads
# ===========================================================================
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=10

# ===========================================================================
# Observabilidade e docs
# ===========================================================================
LOG_LEVEL=info
SWAGGER_ENABLED=true

# Em deploys com varias replicas, mantenha true em apenas uma instancia.
SCHEDULER_ENABLED=true
