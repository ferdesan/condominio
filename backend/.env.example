# ===========================================================================
# Aplicacao
# ===========================================================================
NODE_ENV=development
PORT=3333
API_PREFIX=/api/v1
APP_NAME=Condominio SaaS
API_URL=http://localhost:3333

# ===========================================================================
# Banco de dados (MySQL 8+)
# ===========================================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=condominio
DB_PASSWORD=condominio
DB_NAME=condominio
DB_LOGGING=false
# Nunca habilite em producao: use migrations.
DB_SYNCHRONIZE=false
DB_POOL_SIZE=10

# ===========================================================================
# Redis (cache, rate limit distribuido). REDIS_ENABLED=false usa memoria local.
# ===========================================================================
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL_SECONDS=60

# ===========================================================================
# Autenticacao — GERE NOVOS SEGREDOS ANTES DE IR PARA PRODUCAO
# openssl rand -base64 48
# ===========================================================================
JWT_SECRET=troque-este-segredo-em-producao-32-caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-este-refresh-em-producao-32-caracteres
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
PASSWORD_RESET_TTL_MINUTES=30

# ===========================================================================
# Seguranca
# ===========================================================================
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
# Habilite quando a API estiver atras de proxy/load balancer.
TRUST_PROXY=false

# ===========================================================================
# Uploads
# ===========================================================================
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=10

# ===========================================================================
# Observabilidade e docs
# ===========================================================================
LOG_LEVEL=info
SWAGGER_ENABLED=true

# Em deploys com varias replicas, mantenha true em apenas uma instancia.
SCHEDULER_ENABLED=true
